[Unit]
Description=渠道检测网页服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=channelaudit
Group=channelaudit
WorkingDirectory=/opt/channel-audit
Environment=PYTHONPATH=/opt/channel-audit/current/tools
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
Environment=TMPDIR=/opt/channel-audit/runs/tmp
ExecStart=/usr/bin/python3 -B -m token_audit_web.server --port 18766 --data-root /opt/channel-audit/runs --auth-file /opt/channel-audit/auth.json --origin https://audit.87-76-198-249.sslip.io:8444
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
LimitNOFILE=4096
TasksMax=768
MemoryMax=1G
CPUQuota=200%
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/channel-audit/runs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
